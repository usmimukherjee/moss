{
  "manifest_version": 3,
  "name": "Moss — focus, softly",
  "version": "1.0.0",
  "description": "A quiet Pomodoro timer and gentle focus companion.",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Moss" },
  "commands": {
    "open-still": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Open Moss"
    }
  }
}
